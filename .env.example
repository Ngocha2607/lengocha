# Copy this file to `.env.local` (git-ignored) and fill in real values.
# In production, set the same variables in your Vercel project settings.

# Public site URL — used for `metadataBase` and the absolute OG/canonical URLs
# in src/app/layout.tsx. Optional: it falls back to the production URL, so a
# local checkout needs it only to advertise a different origin.
NEXT_PUBLIC_SITE_URL=https://lengocha.vercel.app

# --- Notion "Writing" integration (optional) --------------------------------
# When both are set, the Writing section and /writing/[slug] pages are driven by
# a Notion database. When unset, the site falls back to a hardcoded entry.
#
# 1. Create an internal integration at https://www.notion.so/my-integrations
#    and copy its "Internal Integration Secret" here.
# 2. Create a database with these properties (case-sensitive):
#      Title (title) · Description (rich_text) · Tags (multi_select)
#      Published (checkbox) · Date (date) · Slug (rich_text, optional)
# 3. Open the database → ••• menu → "Connections" → add your integration.
# 4. Copy the database id from its URL (the 32-char id before `?v=`).
NOTION_TOKEN=
NOTION_WRITING_DB_ID=

# --- Analytics (optional) ------------------------------------------------------
# Vercel Web Analytics is always on (pageviews). Its CUSTOM events — the contact,
# CV, outbound-link and window events in src/lib/analytics.ts — are recorded only
# on Vercel's Pro/Enterprise plans, so on Hobby they go to Umami (and/or GA4).
# Each third-party script loads only when its id is set, and only on the
# canonical host (NEXT_PUBLIC_SITE_URL), so local and preview runs send nothing.
# All three ids are public. Each one can be set here (in Vercel) OR in the
# DEFAULT_* constants at the top of src/lib/analytics.ts; the env var wins.
#
# Cloudflare Web Analytics beacon token (pageviews + Core Web Vitals, no cookies).
# Defaults in code to the lengocha.vercel.app site; set only to override.
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Umami Cloud (custom events, no cookies): Settings → Websites → Website ID (UUID).
# Defaults in code to the lengocha.vercel.app website; set only to override.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Google Analytics 4 (optional, sets cookies): Admin → Data streams → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

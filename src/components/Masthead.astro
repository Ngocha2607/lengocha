---
import { SITE, SOCIAL, SECTIONS } from "../consts";

/**
 * Front-page nameplate. Deliberately not a nav bar over a hero: the page is
 * laid out as a broadsheet, so it opens with a nameplate, a dateline of hard
 * facts, and a numbered "In this issue" index. Nine sections do not fit in a
 * horizontal nav, but they fit an index perfectly — and an index is what a
 * recruiter scans first anyway.
 */

/** Column-major so the index reads down, then across, like a real contents. */
const perColumn = Math.ceil(SECTIONS.length / 3);
const columns = [0, 1, 2].map((c) =>
  SECTIONS.slice(c * perColumn, (c + 1) * perColumn).map((section, i) => ({
    ...section,
    n: String(c * perColumn + i + 1).padStart(2, "0"),
  })),
);

const facts = [
  SITE.role,
  `${SITE.location} · ${SITE.timezone}`,
  `Edition ${SITE.edition}`,
];
---

<header class="border-b-4 border-rule">
  {/* Nameplate */}
  <div class="border-b-4 border-rule px-4 pt-8 pb-4 sm:px-6">
    <h1 class="headline text-[clamp(2.75rem,13vw,7.5rem)] leading-[0.88]">
      <a href="#lead" class="hover:bg-acid focus-visible:bg-acid">{SITE.name}</a>
    </h1>
  </div>

  {/* Dateline: the facts a scanner wants in the first two seconds. */}
  <div
    class="flex flex-wrap items-stretch divide-y-2 divide-rule border-b-2 border-rule sm:divide-x-2 sm:divide-y-0"
  >
    {
      facts.map((fact) => (
        <p class="kicker grow basis-full px-4 py-2.5 sm:basis-0 sm:px-5">{fact}</p>
      ))
    }
    <p
      class="kicker flex grow basis-full items-center gap-2 bg-acid px-4 py-2.5 sm:basis-0 sm:px-5"
    >
      <span class="h-2 w-2 shrink-0 bg-ink" aria-hidden="true"></span>
      {SITE.availability}
    </p>
  </div>

  {/* In this issue */}
  <nav class="px-4 py-6 sm:px-6" aria-labelledby="issue-index-title">
    <h2 id="issue-index-title" class="kicker mb-4">In this issue</h2>
    <ol class="grid gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        columns.flat().map((section) => (
          <li class="border-t-2 border-rule">
            <a
              class="group flex items-baseline gap-3 py-2 hover:bg-acid focus-visible:bg-acid"
              href={`#${section.id}`}
              data-nav-link={section.id}
            >
              <span class="label text-ink-3 tabular-nums group-hover:text-ink">
                {section.n}
              </span>
              <span class="font-mono text-sm font-bold">{section.label}</span>
              <span class="kicker ml-auto hidden text-ink-3 sm:block">
                {section.kicker}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {/* Contact strip, so the ways to reach him sit above the fold too. */}
  <ul
    class="flex flex-wrap divide-x-2 divide-rule border-t-2 border-rule"
    aria-label="Elsewhere"
  >
    {
      SOCIAL.map(({ label, href }) => (
        <li class="grow basis-0">
          <a
            class="label block px-4 py-3 text-center hover:bg-acid focus-visible:bg-acid"
            href={href}
            target={href.startsWith("mailto:") ? undefined : "_blank"}
            rel={href.startsWith("mailto:") ? undefined : "noreferrer noopener"}
          >
            {label}
          </a>
        </li>
      ))
    }
    <li class="grow basis-0 border-l-2 border-rule">
      <a
        class="label block bg-ink px-4 py-3 text-center text-paper hover:bg-acid hover:text-ink focus-visible:bg-acid focus-visible:text-ink"
        href="/resume.pdf"
        target="_blank"
        rel="noreferrer noopener"
        aria-label="Résumé (opens in a new tab)"
      >
        Résumé ↓
      </a>
    </li>
  </ul>
</header>

{/*
  Sentinel: when the masthead scrolls out, the reading rail comes in. Cheaper
  and jitter-free compared with watching scroll offsets.
*/}
<div data-masthead-end aria-hidden="true"></div>

{/*
  The reading rail. Not a nav bar — it reports where you are and offers one way
  back to the index, which is all nine sections' worth of navigation without a
  nine-item bar.
*/}
{/*
  Fixed, not sticky. As a sticky block it still occupied its own height in the
  flow, which opened a dead band under the masthead and let the hidden rail
  translate up over the contact strip. Fixed takes it out of flow entirely; the
  wrapper re-centres it on the same measure as the page column.
*/}
<div
  class="pointer-events-none fixed top-0 left-1/2 z-30 w-full max-w-6xl -translate-x-1/2 px-0"
>
  <p
    class="pointer-events-auto flex -translate-y-full items-center gap-3 border-y-2 border-rule bg-paper/95 px-4 py-2 opacity-0 backdrop-blur transition-all duration-200 sm:px-6"
    data-reading-rail
  >
    <span class="kicker text-ink-3">Reading</span>
    <span class="label tabular-nums" data-rail-index>01</span>
    <span class="font-mono text-sm font-bold" data-rail-label>
      {SECTIONS[0].label}
    </span>
    {/*
      Contact lives here rather than in a floating button. A fixed bubble
      bottom-right covered the content it was floating over, and the page now
      has the email in the masthead, in this rail and in its own section.
    */}
    <a
      class="label ml-auto border-2 border-rule px-2 py-1 hover:bg-acid focus-visible:bg-acid"
      href="#issue-index-title"
    >
      Index ↑
    </a>
    <a
      class="label border-2 border-rule bg-ink px-2 py-1 text-paper hover:bg-acid hover:text-ink focus-visible:bg-acid focus-visible:text-ink"
      href={`mailto:${SITE.email}?subject=Let%27s%20talk`}
    >
      Email
    </a>
  </p>
</div>

<script>
  import { SECTIONS } from "../consts";

  /**
   * Two observers, no scroll handler: one flips the reading rail once the
   * masthead is out of view, the other tracks which section is in the reading
   * band. Together they are the only page-shell JavaScript on the site.
   */
  const rail = document.querySelector<HTMLElement>("[data-reading-rail]");
  const sentinel = document.querySelector("[data-masthead-end]");
  const railIndex = document.querySelector<HTMLElement>("[data-rail-index]");
  const railLabel = document.querySelector<HTMLElement>("[data-rail-label]");
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );

  const HIDDEN = ["-translate-y-full", "opacity-0"];

  if (rail && sentinel) {
    new IntersectionObserver(
      ([entry]) => {
        // Sentinel visible => we are still in the masthead => rail stays away.
        for (const cls of HIDDEN) rail.classList.toggle(cls, entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(sentinel);
  }

  const sections = SECTIONS.map((section) => ({
    ...section,
    el: document.getElementById(section.id),
  })).filter((s): s is typeof s & { el: HTMLElement } => s.el !== null);

  if (sections.length > 0) {
    // Keyed by plain string: SECTIONS is `as const`, so inferring the key type
    // narrows it to the id union and `entry.target.id` no longer fits.
    const byId = new Map<string, { label: string; id: string; n: number }>(
      sections.map((section, i) => [
        section.id,
        { label: section.label, id: section.id, n: i + 1 },
      ]),
    );

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const current = byId.get(entry.target.id);
          if (!current) continue;

          if (railIndex) {
            railIndex.textContent = String(current.n).padStart(2, "0");
          }
          if (railLabel) railLabel.textContent = current.label;

          for (const link of links) {
            const on = link.dataset.navLink === current.id;
            link.classList.toggle("bg-acid", on);
            if (on) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-25% 0px -60% 0px" },
    );

    for (const section of sections) spy.observe(section.el);
  }
</script>

---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { getPublishedPosts, type PostMeta } from "../lib/notion";
import { BLOB_HOST } from "../consts";

/**
 * Writing: rows with a cover on the left, the title and description on the
 * right.
 *
 * The posts have no images, and none of the obvious ways to give them one work
 * here. A Notion page cover is a signed URL that expires within the hour, which
 * AGENTS.md already records as the reason embedded images 404 near the
 * revalidation boundary. A raster generated at build time goes stale the moment
 * a title changes and does not exist at all for a post published afterwards,
 * because this list is fetched per request and cached by ISR — a static cover
 * would quietly undo that.
 *
 * So the cover is drawn from what the post already carries: its own Notion
 * emoji, its primary tag and its year, over a wash of both accents. Whoever
 * writes the post picks the emoji, so it is authored rather than decorative, and
 * there is nothing to fetch, regenerate or invalidate.
 *
 * The tile used to render the title, which then appeared twice in every row.
 */

interface ArticleCard {
  key: string;
  year: string;
  title: string;
  description: string;
  tags: string[];
  href: string;
  internal: boolean;
  /** Notion page emoji. Empty is fine — the cover falls back to the tag alone. */
  emoji: string;
  /** Cover image from Notion, or "" to draw one instead. */
  coverUrl: string;
  /** True when the cover is on a host Astro and Vercel are both allowed to optimize. */
  coverOptimizable: boolean;
}

/**
 * Covers are meant to live in the Vercel Blob store named by `BLOB_HOST`, which
 * is the same value `astro.config.mjs` allowlists — an exact match on both
 * sides, so a cover from some other Blob store falls back to a plain `<img>`
 * rather than being handed to an optimizer that would reject it. Anything else still renders — the `Cover` property is
 * free text and someone will paste a link from elsewhere — but it goes out as a
 * plain `<img>`, because Astro refuses to optimize a host it was not told about
 * and Vercel would reject the request anyway.
 *
 * `new URL` rather than a string match, so a malformed value fails to a plain
 * `<img>` instead of throwing during render.
 */
function isOptimizable(url: string): boolean {
  try {
    return new URL(url).hostname === BLOB_HOST;
  } catch {
    return false;
  }
}

/**
 * Shown when the Notion integration is not configured, so the section is never
 * empty. Once NOTION_TOKEN + NOTION_WRITING_DB_ID are set, published Notion
 * posts take over automatically.
 */
const FALLBACK: ArticleCard[] = [
  {
    key: "appsec-handbook",
    year: "2026",
    title: "Sổ tay AppSec cho Frontend — Gitleaks · Trivy · Semgrep",
    description:
      "A hands-on AppSec handbook for frontend engineers with no security background: three classes of risk mapped to three tools, wired into pre-commit and GitLab CI, plus a runbook for when the pipeline goes red.",
    tags: ["AppSec", "Gitleaks", "Trivy", "Semgrep", "CI/CD"],
    href: "https://app.notion.com/p/S-tay-AppSec-cho-Frontend-Gitleaks-Trivy-Semgrep-3a5b7b727ddd81abb32ff56df403c846?source=copy_link",
    internal: false,
    emoji: "🛡️",
    coverUrl: "",
    coverOptimizable: false,
  },
];

function toCard(post: PostMeta): ArticleCard {
  return {
    key: post.id,
    year: post.date.slice(0, 4),
    title: post.title,
    description: post.description,
    tags: post.tags,
    href: `/writing/${post.slug}`,
    internal: true,
    emoji: post.emoji,
    coverUrl: post.coverUrl,
    coverOptimizable: isOptimizable(post.coverUrl),
  };
}

const posts = await getPublishedPosts();
const articles = posts.length > 0 ? posts.map(toCard) : FALLBACK;
---

<section
  id="writing"
  class="container mx-auto mb-28 scroll-mt-24 px-6"
  aria-labelledby="writing-title"
>
  <SectionHeading id="writing-title" icon="pen" kicker="Writing">
    Posts
    <Fragment slot="lead">
      Write-ups I publish for my team, and for anyone reviewing me. They cover
      the reasoning behind a decision rather than just the result — the closest
      thing to seeing how I work before you talk to me.
    </Fragment>
  </SectionHeading>

  {
    articles.map((article) => (
      <a
        class="group relative mb-8 flex flex-col items-center justify-between gap-8 pb-8 md:flex-row md:gap-12 rule cursor-pointer"
        href={article.href}
        target={article.internal ? undefined : "_blank"}
        rel={article.internal ? undefined : "noreferrer noopener"}
      >
        {/*
          Decoration either way: the title, tag and year all appear as real text
          in the column beside it, so there is nothing here for a screen reader
          to gain, and the image is a cover rather than content.

          The aspect ratio lives on the container, so a Notion cover of any
          shape drops in with `object-cover` and cannot shift the layout. If the
          image fails — an expiring Notion file URL will, eventually — the drawn
          wash underneath shows through instead of a broken-image icon.
        */}
        <div
          class="post-cover group-hover:border-primary/50 grid aspect-[610/400] w-full place-items-center transition md:max-w-[610px]"
          aria-hidden="true"
        >
          {article.coverOptimizable ? (
            /*
              Explicit width/height rather than `inferSize`, which would fetch
              the image server-side on every uncached render of an ISR page.
              The numbers only set the ratio used to build the srcset — the
              container owns the box — so they match the 610/400 frame.
              `widths` names only sizes declared in `imagesConfig.sizes`.
            */
            <Image
              class="absolute inset-0 h-full w-full object-cover"
              src={article.coverUrl}
              width={800}
              height={525}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 610px, 100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : article.coverUrl ? (
            <img
              class="absolute inset-0 h-full w-full object-cover"
              src={article.coverUrl}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="relative grid justify-items-center gap-4 p-8 text-center">
              {article.emoji && (
                <span class="text-6xl leading-none md:text-7xl">{article.emoji}</span>
              )}
              {article.tags[0] && (
                <span class="label text-primary-ink">{article.tags[0]}</span>
              )}
              <span class="label text-secondary tabular-nums">{article.year}</span>
            </div>
          )}
        </div>

        <div class="space-y-4 text-center md:text-left">
          <p class="text-sm tabular-nums text-secondary">{article.year}</p>
          <h3 class="heading max-w-xl text-2xl md:text-4xl">
            {article.title}
          </h3>
          {article.description && (
            <p class="mx-auto max-w-xl text-lg text-secondary md:mx-0 md:text-2xl">
              {article.description}
            </p>
          )}
          <ul class="flex flex-wrap justify-center gap-2 md:justify-start">
            {article.tags.map((tag) => (
              <li class="pill px-3 py-1 text-sm">{tag}</li>
            ))}
          </ul>
          <p class="text-sm text-secondary underline group-hover:text-foreground">
            {article.internal ? "Read the post ↗" : "Read on Notion ↗"}
            {!article.internal && <span class="sr-only"> (opens in a new tab)</span>}
          </p>
        </div>
      </a>
    ))
  }
</section>

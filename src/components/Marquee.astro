---
/**
 * The scrolling word band the template uses over its Work and Posts sections.
 * Two identical runs sit side by side and the pair translates -50%, so the
 * loop is seamless. The second run is aria-hidden — a screen reader should
 * hear the section name once, not twenty times.
 *
 * `overflow-hidden` is on the wrapper, so the band never widens the document.
 * A full-bleed trick here is exactly what gave an earlier build a horizontal
 * scrollbar on mobile.
 */
interface Props {
  /** The word to repeat, e.g. "work". */
  word: string;
  /** Heading id, so the section can point aria-labelledby at it. */
  id: string;
  repeat?: number;
}

const { word, id, repeat = 10 } = Astro.props;
const runs = Array.from({ length: repeat });
---

<div class="mb-12 overflow-hidden">
  <div class="flex animate-marquee">
    <div class="flex shrink-0 whitespace-nowrap">
      <h2 id={id} class="sr-only">{word}</h2>
      {
        runs.map((_, i) => (
          <span
            class="section-title -mb-2 mr-4 md:mr-8"
            aria-hidden={i > 0 ? "true" : undefined}
          >
            {word}
          </span>
        ))
      }
    </div>
    <div class="flex shrink-0 whitespace-nowrap" aria-hidden="true">
      {runs.map(() => <span class="section-title -mb-2 mr-4 md:mr-8">{word}</span>)}
    </div>
  </div>
</div>

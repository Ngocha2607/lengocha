---
import SectionHeading from "./SectionHeading.astro";

/**
 * A decision log, written as architecture decision records.
 *
 * New section — the template has nothing like it, and neither did this site.
 * A list of shipped features says what happened; it does not say what the
 * alternatives were, what was given up, or what was deliberately refused,
 * which is the part of a tech lead's job someone is hiring for.
 *
 * Every entry is traceable to the Confluence performance audit, a published
 * Writing post, or the CV. Two of the seven are a "no", and they stay in: a
 * log with no rejections is a brag sheet.
 *
 * Expansion is native <details> — content stays in the DOM, crawlable and
 * keyboard-operable, and costs no JavaScript. The only script is the filter.
 */

type Status = "shipped" | "held" | "reverted";

interface Decision {
  status: Status;
  year: string;
  title: string;
  /** One line a non-engineer takes away without opening the entry. */
  upshot: string;
  context: string;
  options: string[];
  /** Index into `options` of the one taken, so the choice is unambiguous. */
  chosen: number;
  decision: string;
  consequences: string[];
  link?: { href: string; label: string };
}

const STATUS_META: Record<Status, { label: string; tone: string }> = {
  shipped: { label: "Shipped", tone: "bg-foreground text-background" },
  held: { label: "Held", tone: "text-warn outline-warn" },
  reverted: { label: "Reverted", tone: "text-fail outline-fail" },
};

const DECISIONS: Decision[] = [
  {
    status: "shipped",
    year: "2025",
    title: "Rebuild the editor rather than renew a per-seat licence",
    upshot:
      "A cost that grew with student numbers became a one-off piece of engineering.",
    context:
      "The editor sits in front of every student and every teacher, and TinyMCE is licensed per seat — so the bill tracked enrolment. Enrolment is the one number nobody can forecast a year out, and an unforecastable seat count is an unbudgetable line item.",
    options: [
      "Renew, and negotiate the seat count each year",
      "Restrict the editor to fewer roles to hold seats down",
      "Rebuild on an open-source core (Tiptap / ProseMirror)",
    ],
    chosen: 2,
    decision:
      "Rebuild on Tiptap, matched feature for feature against what the product was already paying for, shipped as a package across the lms-fe monorepo.",
    consequences: [
      "A variable licence became fixed engineering cost, and the monthly spend came down with it.",
      "The monorepo no longer loads TinyMCE anywhere.",
      "We own editor bugs now. That is the price of the decision, and it was worth paying — but it is a real cost, not a free win.",
    ],
  },
  {
    status: "held",
    year: "2025",
    title: "Prove out the server-response fix, then keep it out of production",
    upshot:
      "It made one server number look dramatically better without making the page feel faster to a single user, so it waits.",
    context:
      "revalidate = 0 on the root layout forced a dynamic render on every request and switched off the Full Route Cache, so TTFB could not come down however well the client behaved. It was the most obvious item in the audit.",
    options: [
      "Ship it — the mechanism demonstrably works",
      "Ship it behind a flag on a few low-risk routes",
      "Hold it until the client boundary moves down to the leaves",
    ],
    chosen: 2,
    decision:
      "Hold it. The change stayed in the working tree with the measurements written up next to it.",
    consequences: [
      "Dropping revalidate = 0 and wrapping the provider tree in Suspense let 20 routes static-generate; TTFB on the main routes fell from roughly 60ms to 3ms locally, with a year-long s-maxage and a cache hit.",
      "But useSearchParams() sits at the top of the provider tree, so the whole thing bails out to client-side rendering and the real content still arrives after hydrate. TTFB moves; LCP does not.",
      "A shell cached at the CDN also has to be provably free of user-specific data before it goes anywhere near production.",
      "A good change in the wrong order. It ships after the client boundary moves down and the critical pages fetch on the server — otherwise it is a 15× win on a number no user feels.",
    ],
    link: { href: "#performance", label: "The audit it came out of" },
  },
  {
    status: "shipped",
    year: "2025",
    title: "One monorepo for four frontends, with a layer that can be enforced",
    upshot: "Four products stopped re-implementing the same interface four times.",
    context:
      "lms-pro, lms-test and lms-finhub, plus the operations back-office, were drifting apart — the same components, editor and stylesheets rebuilt per app, and no single place to fix anything.",
    options: [
      "Separate repos with a published component package",
      "One monorepo with a task graph over a shared layer",
      "One application with per-customer feature flags",
    ],
    chosen: 1,
    decision:
      "A pnpm workspace with Turborepo running the task graph: apps/ over a shared libs/ (ui, editor, styles), with the CI gate defined once.",
    consequences: [
      "A new app inherits the shared layer and the whole security gate on day one instead of negotiating both later.",
      "Unchanged packages restore from cache, so the pipeline stays usable as apps are added.",
      "The shared layer becomes where code-splitting decisions have to be made, because it is where the heavy things live — editor, document viewer, spreadsheet, charts.",
    ],
    link: { href: "#work", label: "The products it builds" },
  },
  {
    status: "shipped",
    year: "2025",
    title: "Sell the platform by module, and strip what isn't bought at build time",
    upshot:
      "Each customer's build contains only the features they paid for, rather than all of them with some hidden.",
    context:
      "Customers buy different feature sets. Hiding a feature behind a runtime flag still ships its code to every one of them.",
    options: [
      "Runtime feature flags per customer",
      "A branch per customer",
      "A module registry plus a codegen step before the build",
    ],
    chosen: 2,
    decision:
      "A module registry plus a codegen step that strips unpurchased features before the build runs.",
    consequences: [
      "Per-customer white-label builds come out of one repository.",
      "The build gains a generation step, so the registry is now load-bearing — if it lies, a customer ships with the wrong feature set.",
    ],
    link: {
      href: "/writing/ban-lms-theo-module-kien-truc-plugin-trong-monorepo-next-js",
      label: "Written up in full",
    },
  },
  {
    status: "shipped",
    year: "2025",
    title: "Put application security in the pipeline, not in a training session",
    upshot: "Every code change is checked automatically before a person reviews it.",
    context:
      "Frontend engineers rarely get security training, and the knowledge does not arrive by asking people to be careful.",
    options: [
      "Run a training session and hand out a checklist",
      "Book an external audit each release",
      "Gate every merge request automatically, from shared config",
    ],
    chosen: 2,
    decision:
      "Gitleaks, Trivy, Semgrep and OWASP ZAP wired into GitLab CI, gating every merge request from configuration the whole workspace shares.",
    consequences: [
      "Leaked secrets, vulnerable dependencies and insecure patterns are caught before review, so review time goes on design instead of hygiene.",
      "The pipeline carries the knowledge the team does not have yet — a new engineer inherits it without being taught it.",
      "Qualitative by design: the gate reports pass or fail, and I do not quote scan counts I cannot reproduce in an interview.",
    ],
    link: {
      href: "/writing/so-tay-appsec-cho-frontend-gitleaks-trivy-semgrep",
      label: "The handbook I wrote for the team",
    },
  },
  {
    status: "reverted",
    year: "2025",
    title: "Take the lazy wrapper back off the spreadsheet",
    upshot:
      "A rule that made every other route faster made one route worse, so that route keeps the old behaviour.",
    context:
      "The shared component layer is being moved onto load-on-demand: video and audio pull dashjs on demand, the Word preview pulls docx-preview on demand. The spreadsheet got the same treatment for consistency.",
    options: [
      "Keep it lazy, for consistency across the library",
      "Keep it lazy and cover the gap with a skeleton",
      "Revert to a static import on the one route that needs it",
    ],
    chosen: 2,
    decision:
      "Revert. The essay-answer form needs the spreadsheet immediately, so the lazy wrapper was removed rather than kept for tidiness.",
    consequences: [
      "That one route carries the weight; every other route stopped loading the spreadsheet at all.",
      "The rule is load-on-demand where it pays, not load-on-demand everywhere. Consistency lost to measurement, which is the right way round.",
    ],
  }
];

const counts = {
  all: DECISIONS.length,
  shipped: DECISIONS.filter((d) => d.status === "shipped").length,
  held: DECISIONS.filter((d) => d.status === "held").length,
  reverted: DECISIONS.filter((d) => d.status === "reverted").length,
};

const FILTERS = [
  { key: "all", label: "All", count: counts.all },
  { key: "shipped", label: "Shipped", count: counts.shipped },
  { key: "held", label: "Held", count: counts.held },
  { key: "reverted", label: "Reverted", count: counts.reverted },
];
---

<section
  id="decisions"
  class="container mx-auto mb-28 scroll-mt-24 p-6"
  aria-labelledby="decisions-title"
>
  <SectionHeading id="decisions-title" icon="fork" kicker="Decision log">
    Decisions
    <Fragment slot="lead">
      Seven engineering decisions with the alternatives I weighed and what each
      one cost. Two are a no — one change I measured, proved out and kept out of
      production, and one I shipped and then undid. Those two are the useful
      entries.
    </Fragment>
  </SectionHeading>

  <div class="mt-10" data-decision-log>
    <div
      class="mb-10 flex flex-wrap items-center gap-3"
      role="group"
      aria-label="Filter decisions by outcome"
    >
      {
        FILTERS.map((filter) => (
          <button
            type="button"
            class="pill cursor-pointer px-4 py-2 text-sm transition hover:bg-accent hover:text-black aria-pressed:bg-foreground aria-pressed:text-background aria-pressed:outline-none"
            data-filter={filter.key}
            aria-pressed={filter.key === "all" ? "true" : "false"}
          >
            {filter.label}
            <span class="tabular-nums opacity-60">{filter.count}</span>
          </button>
        ))
      }
      <p class="text-sm text-secondary" aria-live="polite" data-filter-status>
        Showing all {counts.all}
      </p>
    </div>

    <ol>
      {
        DECISIONS.map((decision, i) => {
          const meta = STATUS_META[decision.status];
          return (
            <li class="rule mb-6 pb-6" data-decision data-status={decision.status}>
              <details class="group">
                <summary class="flex cursor-pointer list-none flex-col gap-3">
                  <span class="flex flex-wrap items-center gap-3">
                    <span class="text-sm tabular-nums text-secondary">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span
                      class:list={[
                        "rounded-4xl px-3 py-1 text-sm outline-1",
                        meta.tone,
                      ]}
                    >
                      {meta.label}
                    </span>
                    <span class="text-sm tabular-nums text-secondary">
                      {decision.year}
                    </span>
                    <span class="ml-auto text-sm text-secondary group-open:hidden" aria-hidden="true">
                      Open +
                    </span>
                    <span class="ml-auto hidden text-sm text-secondary group-open:inline" aria-hidden="true">
                      Close −
                    </span>
                  </span>

                  <span class="heading max-w-3xl text-xl md:text-3xl">
                    {decision.title}
                  </span>
                  <span class="max-w-2xl text-lg text-secondary">
                    {decision.upshot}
                  </span>
                </summary>

                <div class="mt-8 grid gap-8 lg:grid-cols-2">
                  <div class="panel p-6">
                    <h3 class="heading text-lg text-secondary">
                      The situation
                    </h3>
                    <p class="mt-3 text-secondary">{decision.context}</p>

                    <h3 class="heading mt-8 text-lg text-secondary">
                      What I weighed
                    </h3>
                    <ul class="mt-3 space-y-3">
                      {decision.options.map((option, oi) => (
                        <li class="flex gap-3">
                          <span
                            class:list={[
                              "mt-1.5 h-3 w-3 shrink-0 rounded-full border border-border",
                              oi === decision.chosen && "bg-primary",
                            ]}
                            aria-hidden="true"
                          />
                          <span
                            class:list={[
                              oi === decision.chosen
                                ? "text-foreground"
                                : "text-secondary line-through",
                            ]}
                          >
                            {option}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="panel p-6">
                    <h3 class="heading text-lg text-secondary">
                      What I did
                    </h3>
                    <p class="mt-3">{decision.decision}</p>

                    <h3 class="heading mt-8 text-lg text-secondary">
                      What it cost, and what it bought
                    </h3>
                    <ul class="mt-3 space-y-3">
                      {decision.consequences.map((consequence) => (
                        <li class="flex gap-3 text-secondary">
                          <span
                            class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-foreground"
                            aria-hidden="true"
                          />
                          <span>{consequence}</span>
                        </li>
                      ))}
                    </ul>

                    {decision.link && (
                      <p class="mt-6">
                        <a class="link" href={decision.link.href}>
                          {decision.link.label} →
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </details>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  for (const log of document.querySelectorAll<HTMLElement>("[data-decision-log]")) {
    const buttons = Array.from(
      log.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    );
    const entries = Array.from(log.querySelectorAll<HTMLElement>("[data-decision]"));
    const status = log.querySelector<HTMLElement>("[data-filter-status]");

    function apply(key: string) {
      let shown = 0;

      for (const entry of entries) {
        const match = key === "all" || entry.dataset.status === key;
        entry.hidden = !match;
        if (match) shown += 1;
        // Collapse what is hidden, so re-showing it starts closed.
        if (!match) entry.querySelector("details")?.removeAttribute("open");
      }

      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.filter === key));
      }

      if (status) {
        status.textContent =
          key === "all"
            ? `Showing all ${shown}`
            : `Showing ${shown} of ${entries.length}`;
      }
    }

    for (const button of buttons) {
      button.addEventListener("click", () => apply(button.dataset.filter!));
    }
  }
</script>

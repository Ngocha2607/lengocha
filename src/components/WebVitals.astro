---
/**
 * Live LCP/FCP/TTFB/INP/CLS for the page the visitor is on, measured with
 * web-vitals and rendered locally. Nothing is sent anywhere.
 *
 * New section — the template has no equivalent. It exists because the page
 * claims to be fast in two places, and this is the one reading a visitor can
 * take themselves.
 *
 * It mirrors the five metrics the Performance section quotes as lab data, so
 * the two strips read as a pair — `plain` must stay word-for-word identical to
 * FIELD_METRICS over there. Unmeasured metrics show an em dash, never a
 * placeholder number, and every state occupies the same number of lines so
 * filling in cannot cause the layout shift the widget reports on.
 *
 * Measure against a production build (`LOCAL_PROD=1 npm run build`): the dev
 * server reports a wildly inflated FCP.
 */
const METRICS = [
  { name: "LCP", plain: "main content appears", good: "< 2.5s", pending: "measuring" },
  { name: "FCP", plain: "page starts drawing", good: "< 1.8s", pending: "measuring" },
  { name: "TTFB", plain: "server answers", good: "< 0.8s", pending: "measuring" },
  // INP cannot exist until the visitor interacts, so say so rather than sit blank.
  { name: "INP", plain: "taps respond", good: "< 200ms", pending: "needs a click" },
  { name: "CLS", plain: "layout holds still", good: "< 0.1", pending: "measuring" },
];
---

<section class="container mx-auto mb-16 p-6" aria-labelledby="vitals-title" data-vitals>
  <div class="panel p-6 md:p-10">
    <p class="pill mb-4 w-max bg-accent text-sm text-black">Live</p>
    <h2 id="vitals-title" class="heading text-2xl md:text-4xl">
      This page, measured in your browser
    </h2>
    <p class="mt-4 max-w-3xl text-lg text-secondary">
      The same five checks the Performance section reports on the LMS — run
      against this page, on your device, as you read it. Nothing leaves the page.
    </p>

    <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-5">
      {
        METRICS.map((metric) => (
          <li
            class="rounded-3xl border border-border p-4"
            data-metric={metric.name}
            data-good={metric.good}
            data-pending={metric.pending}
          >
            <p class="label flex items-center gap-2">
              <span
                class="h-2.5 w-2.5 shrink-0 rounded-full border border-border"
                aria-hidden="true"
                data-box
              />
              {metric.name}
            </p>
            <p class="mt-1 min-h-8 text-xs leading-tight text-secondary">
              {metric.plain}
            </p>
            <p class="heading mt-1 text-2xl tabular-nums text-secondary" data-value>
              —
            </p>
            <p class="font-plex text-xs tabular-nums text-secondary" data-note>
              {metric.pending}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 max-w-3xl text-sm text-secondary">
      Measured with
      <a
        class="link"
        href="https://github.com/GoogleChrome/web-vitals"
        target="_blank"
        rel="noreferrer noopener">web-vitals</a
      >
      against the Core Web Vitals thresholds. It is one sample on your device and
      your network, not a p75, so read it as a spot check rather than a score.
      Everything in the Performance section is lab data from a codebase you
      can&apos;t open; this is the reading you can take yourself.
    </p>
  </div>
</section>

<script>
  import { onCLS, onFCP, onINP, onLCP, onTTFB, type Metric } from "web-vitals";

  const root = document.querySelector<HTMLElement>("[data-vitals]");

  if (root) {
    const cells = new Map<string, HTMLElement>();
    for (const cell of root.querySelectorAll<HTMLElement>("[data-metric]")) {
      cells.set(cell.dataset.metric!, cell);
    }

    const seconds = (value: number) => `${(value / 1000).toFixed(2)}s`;
    const format: Record<string, (value: number) => string> = {
      LCP: seconds,
      FCP: seconds,
      TTFB: seconds,
      INP: (value) => `${Math.round(value)}ms`,
      CLS: (value) => value.toFixed(3),
    };

    const TONE: Record<Metric["rating"], string> = {
      good: "text-pass",
      "needs-improvement": "text-warn",
      poor: "text-fail",
    };

    const record = (metric: Metric) => {
      const cell = cells.get(metric.name);
      if (!cell) return;

      const value = cell.querySelector<HTMLElement>("[data-value]")!;
      const note = cell.querySelector<HTMLElement>("[data-note]")!;
      const box = cell.querySelector<HTMLElement>("[data-box]")!;

      value.textContent = (format[metric.name] ?? String)(metric.value);
      value.classList.remove("text-secondary");
      for (const tone of Object.values(TONE)) {
        value.classList.toggle(tone, tone === TONE[metric.rating]);
      }

      note.textContent = cell.dataset.good!;
      box.classList.toggle("bg-pass", metric.rating === "good");
      box.classList.toggle("bg-warn", metric.rating === "needs-improvement");
      box.classList.toggle("bg-fail", metric.rating === "poor");
    };

    // reportAllChanges keeps the readout live. The default only reports once the
    // page is hidden, which is useless for something rendered on screen.
    const options = { reportAllChanges: true };
    onLCP(record, options);
    onFCP(record, options);
    onTTFB(record, options);
    onINP(record, options);
    onCLS(record, options);
  }
</script>

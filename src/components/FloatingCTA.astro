---
import { SITE } from "../consts";

/**
 * The accessible name has to start with the visible text, or WCAG 2.5.3
 * (Label in Name) fails: a voice-control user saying "Let's talk" would not
 * match a name that begins "Email Lê Ngọc Hà".
 */
const ariaLabel =
  "Let's talk — email Lê Ngọc Hà, available for hire (opens your email client)";
---

<a
  href={`mailto:${SITE.email}?subject=Let%27s%20talk`}
  class="label group fixed right-4 bottom-4 z-40 inline-flex items-center gap-2.5 border-2 border-rule bg-acid px-4 py-3 hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper"
  style="box-shadow:4px 4px 0 0 var(--color-ink)"
  aria-label={ariaLabel}
>
  <span
    class="h-2.5 w-2.5 bg-ink group-hover:bg-acid group-focus-visible:bg-acid"
    aria-hidden="true"></span>
  Let&apos;s talk
</a>

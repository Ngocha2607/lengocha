---
import SectionHeading from "./SectionHeading.astro";

interface ExperienceEntry {
  period: string;
  title: string;
  url?: string;
  subtitle?: string;
  description: string;
  /**
   * Optional deep-dive article. `href` points at an internal /writing/[slug]
   * route, so only add it once the post is published in Notion — an
   * unpublished slug 404s.
   */
  writeup?: { href: string; label: string };
  tags: string[];
}

const experiences: ExperienceEntry[] = [
  {
    period: "2025 — Present",
    title: "Frontend Tech Lead · SAPP Academy",
    url: "https://sapp.edu.vn",
    description:
      "Led the frontend technical direction and architecture across SAPP’s product ecosystem (LMS, Ops), defining coding standards, leading code reviews, and mentoring two junior engineers. Designed a Monorepo with pnpm Workspace and Turborepo, migrated the LMS to Next.js 14 App Router, and ran a performance pass across 15 routes — /courses went 15.2s → 6.1s with Lighthouse Performance 29 → 65, lifting the student route group to 49 → 67. Built a shared Tiptap editor package that replaced TinyMCE across the monorepo, cutting a per-seat subscription and standardizing the editing experience. Integrated a security pipeline (Gitleaks, Trivy, Semgrep, ZAP) and AI workflows that save the team ~10 hours per week.",
    writeup: {
      href: "/writing/ban-lms-theo-module-kien-truc-plugin-trong-monorepo-next-js",
      label: "Bán LMS theo module: kiến trúc plugin trong monorepo Next.js",
    },
    tags: [
      "Next.js",
      "TypeScript",
      "Turborepo",
      "pnpm Workspace",
      "Tiptap",
      "Redux Toolkit",
      "Tailwind CSS",
    ],
  },
  {
    period: "2023 — 2025",
    title: "Fullstack Developer · Tweet World Travel Group",
    url: "https://tweetworldtravel.com",
    description:
      "Built Spring Boot microservices and high-performance React/Next.js applications across five B2B/B2C e-commerce platforms and a multilingual ERP serving 1K+ monthly users. Optimized performance (3.2s → 1.1s, Lighthouse 85+), mentored three junior engineers, and led code reviews to maintain production quality.",
    tags: [
      "Java",
      "Spring Boot",
      "Microservices",
      "React",
      "Next.js",
      "TypeScript",
      "Material UI",
    ],
  },
  {
    period: "2021 — 2023",
    title: "Frontend Developer · Minastik JSC",
    url: "https://www.minastik.com",
    subtitle: "Onsite at 3S Intersoft",
    description:
      "Developed and maintained multiple React.js web applications, building responsive UIs and integrating RESTful APIs with the backend team. Optimized performance and code quality while working in an Agile/Scrum process. Key work included the UI/UX for EVN Hanoi’s power-management system modules.",
    tags: ["React.js", "Redux Toolkit", "RESTful API", "Ant Design", "Agile"],
  },
  {
    period: "2021",
    title: "Software Engineer Intern · FPT Software",
    url: "https://www.fpt-software.com",
    description:
      "Built an employee-management application in C++ and learned core software-development best practices.",
    tags: ["C++"],
  },
  {
    period: "2018 — 2022",
    title: "B.Eng, Electronics & Telecommunications · HUST",
    url: "https://hust.edu.vn",
    description:
      "B.Eng in Electronics & Telecommunications (HUST). Published research at REV-ECIT 2021.",
    tags: [],
  },
];
---

<section id="experience" class="scroll-mt-16" aria-labelledby="experience-title">
  <SectionHeading
    id="experience"
    index="03"
    eyebrow="Experience"
    title="Where I've worked"
    lead="Five years, four roles and a degree — intern, frontend developer, fullstack developer, now tech lead. Each entry gives the scope, what came out of it, and the tools involved. The full CV is at the bottom."
  />

  <ol class="border-t-2 border-rule">
    {
      experiences.map((experience) => (
        <li class="border-b-2 border-rule">
          <div class="grid gap-3 py-6 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-6">
            <p class="label text-ink-3">{experience.period}</p>

            <div>
              <h3 class="text-lg">
                {experience.url ? (
                  <a
                    class="link"
                    href={experience.url}
                    target="_blank"
                    rel="noreferrer noopener"
                    aria-label={`${experience.title} (opens in a new tab)`}
                  >
                    {experience.title} ↗
                  </a>
                ) : (
                  experience.title
                )}
              </h3>

              {experience.subtitle && (
                <p class="label mt-1 text-ink-3">{experience.subtitle}</p>
              )}

              <p class="mt-3 max-w-[70ch]">{experience.description}</p>

              {experience.writeup && (
                <p class="mt-3">
                  <a class="link text-sm" href={experience.writeup.href}>
                    Deep dive: {experience.writeup.label} ↗
                  </a>
                </p>
              )}

              {experience.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies used">
                  {experience.tags.map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-8">
    <a
      class="label inline-block border-2 border-rule bg-ink px-4 py-2.5 text-paper hover:bg-acid hover:text-ink focus-visible:bg-acid focus-visible:text-ink"
      href="/resume.pdf"
      target="_blank"
      rel="noreferrer noopener"
      aria-label="View full résumé (opens in a new tab)"
    >
      View full résumé ↓
    </a>
  </p>
</section>

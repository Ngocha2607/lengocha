---
/**
 * Every section opens with one of these. The title and lead are not optional:
 * the page is read both by engineers who will probe the claims and by
 * recruiters who will not, and the lead is the whole of what the second group
 * takes away. It has to stand on its own without the section under it.
 *
 * The numbered acid strip replaces the old sticky-sidebar wayfinding — the
 * header nav is sticky now, so a section only has to announce itself once.
 */
interface Props {
  /** Section id; the heading renders as `${id}-title` for aria-labelledby. */
  id: string;
  /** Two-digit index, e.g. "01". Gives the page a spine to scan. */
  index: string;
  /** Short nav label, matching the header. */
  eyebrow: string;
  title: string;
  lead: string;
}

const { id, index, eyebrow, title, lead } = Astro.props;
---

<div class="mb-10 border-2 border-rule">
  <p
    class="label flex items-center gap-3 border-b-2 border-rule bg-acid px-4 py-2"
  >
    <span class="tabular-nums">{index}</span>
    <span aria-hidden="true">/</span>
    <span>{eyebrow}</span>
  </p>

  <div class="px-4 py-6 sm:px-6 sm:py-8">
    <h2
      id={`${id}-title`}
      class="text-2xl leading-[1.15] text-balance sm:text-3xl md:text-4xl"
    >
      {title}
    </h2>
    <p class="mt-4 max-w-[60ch] text-ink-2">{lead}</p>
  </div>
</div>

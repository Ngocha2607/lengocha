---
import SectionRule from "./SectionRule.astro";
import { SITE, SOCIAL } from "../consts";

/**
 * The section the page had no version of: what happens next. Contact existed
 * only as a floating button and three footer links, with nothing saying what
 * kind of work fits or how to start a conversation.
 *
 * "Where I'm most useful" is framed from work already on this page rather than
 * from a wish list, so it stays checkable. The roles row is the one editorial
 * assertion here — keep it aligned with the availability line in the masthead.
 */

const useful = [
  {
    title: "A frontend that has outgrown its structure",
    body: "Several apps sharing components by copy-paste, a build nobody wants to touch, features that ship per customer. That is the shape of work I've just spent a year on.",
  },
  {
    title: "A product that is slower than the team can explain",
    body: "I start with field data rather than a lab score, find which of loading, interactivity or layout is actually failing, and write down what I chose not to do as well as what I did.",
  },
  {
    title: "A team that needs standards it cannot skip",
    body: "Review conventions, a security gate on every merge request, and handbooks so the answer outlives whoever found it. Two junior engineers currently, three before that.",
  },
];

const openTo = [
  "Senior Frontend Engineer",
  "Frontend Tech Lead",
  "Frontend Architect",
];

const facts = [
  { label: "Based in", value: `${SITE.location} · ${SITE.timezone}` },
  { label: "Availability", value: SITE.availability },
  { label: "Working language", value: "Vietnamese · English" },
];

/** The colophon numbers. Every one is measured on a production build. */
const colophon = [
  { label: "Built with", value: "Astro 6 · Tailwind CSS v4" },
  { label: "Framework JavaScript", value: "None" },
  { label: "Script shipped", value: "1 file · 9.4KB (web-vitals)" },
  { label: "LCP · CLS", value: "187ms · 0.00" },
  { label: "Lighthouse", value: "a11y 100 · best practices 100 · SEO 100" },
  { label: "Writing", value: "Notion API, revalidated hourly" },
];
---

<section id="hiring" class="scroll-mt-14" aria-labelledby="hiring-title">
  <SectionRule
    id="hiring"
    kicker="Contact"
    title="Working together"
    lead="If any of the three situations below sounds like yours, the conversation will be a short one. Everything on this page is a claim you can probe, so bring the awkward questions — the decision log already contains the two I got wrong."
    note="Open to remote"
  />

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-10">
    <div>
      <h3 class="kicker">Where I&apos;m most useful</h3>
      <ol class="mt-3 border-t-2 border-rule">
        {
          useful.map((item, i) => (
            <li class="border-b-2 border-rule py-4">
              <div class="flex gap-3 sm:gap-4">
                <span class="label shrink-0 pt-0.5 text-ink-3 tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0">
                  <h4 class="font-mono text-base leading-snug">{item.title}</h4>
                  <p class="mt-2 max-w-[62ch] text-sm text-ink-2">{item.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <h3 class="kicker mt-8">Open to</h3>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {openTo.map((role) => <li class="chip">{role}</li>)}
      </ul>

      {/* The actual call to action, sized like one. */}
      <div class="mt-8 border-2 border-rule" style="box-shadow:6px 6px 0 0 var(--color-ink)">
        <p class="border-b-2 border-rule bg-acid px-5 py-3 font-mono font-bold">
          Start here
        </p>
        <div class="flex flex-wrap items-center gap-3 px-5 py-5">
          <a
            class="label border-2 border-rule bg-ink px-4 py-2.5 text-paper hover:bg-acid hover:text-ink focus-visible:bg-acid focus-visible:text-ink"
            href={`mailto:${SITE.email}?subject=Let%27s%20talk`}
          >
            Email me ↗
          </a>
          <a
            class="label border-2 border-rule px-4 py-2.5 hover:bg-acid focus-visible:bg-acid"
            href="/resume.pdf"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Résumé, PDF (opens in a new tab)"
          >
            Résumé, PDF ↓
          </a>
          <p class="font-mono text-sm text-ink-2">{SITE.email}</p>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <aside class="breakout" aria-labelledby="facts-title">
        <h3 id="facts-title" class="label border-b-2 border-rule px-4 py-2.5">
          The practical bits
        </h3>
        <dl>
          {
            facts.map((fact) => (
              <div class="border-b-2 border-rule px-4 py-3 last:border-b-0">
                <dt class="kicker text-ink-3">{fact.label}</dt>
                <dd class="mt-1 text-sm text-ink">{fact.value}</dd>
              </div>
            ))
          }
          <div class="border-t-2 border-rule px-4 py-3">
            <dt class="kicker text-ink-3">Elsewhere</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {
                SOCIAL.filter((s) => !s.href.startsWith("mailto:")).map(
                  ({ label, href }) => (
                    <a
                      class="chip hover:bg-acid focus-visible:bg-acid"
                      href={href}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {label} ↗
                    </a>
                  ),
                )
              }
            </dd>
          </div>
        </dl>
      </aside>

      {/*
        Colophon. A newspaper prints how it was made; this one prints the
        numbers, because the page argues about them three sections earlier.
      */}
      <aside class="border-2 border-rule" aria-labelledby="colophon-title">
        <h3 id="colophon-title" class="label border-b-2 border-rule px-4 py-2.5">
          Colophon
        </h3>
        <dl class="divide-y-2 divide-rule">
          {
            colophon.map((row) => (
              <div class="px-4 py-2.5">
                <dt class="kicker text-ink-3">{row.label}</dt>
                <dd class="mt-0.5 font-mono text-xs text-ink">{row.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="border-t-2 border-rule px-4 py-3 text-xs text-ink-2">
          Measured on a production build, not the dev server. The strip below
          measures the page you are reading right now, on your device — so the
          claim is one you can check rather than one you have to take.
        </p>
      </aside>
    </div>
  </div>
</section>

---
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";

import lmsPlatform from "../assets/projects/lms-platform.png";
import opsPortal from "../assets/projects/ops-portal.png";
import subscriberPlatform from "../assets/projects/subscriber-platform.png";
import websiteB2b from "../assets/projects/website-b2b.png";
import newsletter from "../assets/projects/newsletter.png";
import evn from "../assets/projects/evn.png";

interface Project {
  title: string;
  period: string;
  description: string;
  tags: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  href?: string;
  placeholder?: string;
}

const MODULE_WRITEUP =
  "/writing/ban-lms-theo-module-kien-truc-plugin-trong-monorepo-next-js";
const LMS_WRITEUP =
  "/writing/ben-trong-sapp-lms-hai-frontend-mot-he-van-hanh-dao-tao";

const PROJECTS: Project[] = [
  {
    title: "LMS Platform · SAPP Academy",
    period: "2025 — Present",
    description:
      "The learner-facing side of a large-scale learning platform on Next.js 14 App Router — one of four frontends the lms-fe monorepo builds. I own the frontend technical direction, and took the worst route from 15.2s to 6.1s.",
    tags: ["Next.js 14", "App Router", "Turborepo", "TanStack Query"],
    image: lmsPlatform,
    imageAlt: "SAPP Academy learning-management system dashboard",
    href: MODULE_WRITEUP,
  },
  {
    title: "Operations back-office · SAPP",
    period: "2025 — Present",
    description:
      "Sixteen operations modules running the academy behind the LMS: classes, question bank, grading, scheduling and attendance. The attendance system spans repositories, so reconciliation is where the real work sits.",
    tags: ["React", "TypeScript", "Vite", "Ant Design"],
    image: opsPortal,
    imageAlt: "SAPP Academy operations portal showing the class list screen",
    href: LMS_WRITEUP,
  },
  {
    title: "Subscriber Platform · Tweet World",
    period: "2023 — 2025",
    description:
      "Travel-business management platform serving roughly 1,000 users a month, on Spring Boot microservices behind a React frontend. I worked both sides of the wire, which is where the multilingual ERP data model got settled.",
    tags: ["Spring Boot", "Microservices", "React", "Material UI"],
    image: subscriberPlatform,
    imageAlt: "Tweet World Travel subscriber management platform interface",
    href: "https://tweetworldtravel.tkgplatform.com.au/",
  },
  {
    title: "B2B & B2C storefront · Tweet World",
    period: "2023 — 2024",
    description:
      "Multi-language e-commerce covering both the agent and consumer side, with authentication, global state and payments. Cut page load from 3.2s to 1.1s and held mobile Lighthouse above 85 — the dry run for the LMS pass.",
    tags: ["Next.js 14", "Zustand", "TypeScript", "Tailwind CSS"],
    image: websiteB2b,
    imageAlt: "Tweet World Travel B2B and B2C e-commerce website homepage",
    href: "https://tweetworldtravel.com",
  },
  {
    title: "Newsletter builder · Tweet World",
    period: "2023 — 2024",
    description:
      "A drag-and-drop email builder and subscriber system that gave marketing a canvas they could use without a developer in the loop. Template output has to survive email clients, which rules out most of what a browser allows.",
    tags: ["React.js", "GrapeJS", "Laravel API"],
    image: newsletter,
    imageAlt: "Drag-and-drop email newsletter builder interface",
  },
  {
    title: "EVN Hanoi Power Company",
    period: "2022 — 2023",
    description:
      "UI/UX for power-management modules, onsite with 3S Intersoft — dense operational data grids on a .NET Core API. The first codebase I worked in that someone else had to maintain after me, which changed how I write.",
    tags: [".NET Core API", "React.js", "Redux Toolkit", "Ant Design"],
    image: evn,
    imageAlt: "EVN Hanoi power-management system module interface",
    href: "https://3si.vn/en/",
  }
];
---

<section id="work" class="container mx-auto mb-28 scroll-mt-24 px-6" aria-labelledby="work-title">
  <SectionHeading id="work-title" icon="grid" kicker="Selected work">
    Things I&apos;ve built
    <Fragment slot="lead">
      Seven products across four employers. Internal platforms have no public
      URL, so those cards link to the write-up rather than to a login screen.
    </Fragment>
  </SectionHeading>

  {PROJECTS.map((project) => <ProjectCard {...project} />)}
</section>

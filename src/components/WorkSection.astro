---
import SectionRule from "./SectionRule.astro";

/**
 * The record. Kept deliberately tight: the detail behind each role now lives in
 * the decision log, the performance case and the workspace, so repeating it
 * here made the page long without making it say more. Each entry gives scope,
 * outcome and stack, then points at the evidence.
 */

interface Role {
  period: string;
  title: string;
  org: string;
  url?: string;
  subtitle?: string;
  /** One sentence on what the job was. */
  scope: string;
  /** What came out of it. Numbers only where they are sourced. */
  outcomes: string[];
  tags: string[];
  evidence?: { href: string; label: string }[];
}

const ROLES: Role[] = [
  {
    period: "2025 — Present",
    title: "Frontend Tech Lead",
    org: "SAPP Academy",
    url: "https://sapp.edu.vn",
    scope:
      "Own the frontend technical direction across the product ecosystem — a learning platform, a test platform, a finance product and the operations back-office — plus the standards and the people.",
    outcomes: [
      "Consolidated four frontends into one pnpm + Turborepo workspace over a shared component, editor and styles layer.",
      "Migrated the LMS from Next.js 12 to Next.js 14 App Router, then ran a measured performance pass over 15 routes: worst route 15.2s → 6.1s, Lighthouse 29 → 65.",
      "Replaced a per-seat editor licence with an in-house Tiptap package across the whole workspace.",
      "Put Gitleaks, Trivy, Semgrep and OWASP ZAP on every merge request, and designed AI workflows that returned ~10 hours a week to the team.",
      "Mentoring two junior engineers; own coding standards and code review.",
    ],
    tags: [
      "Next.js",
      "TypeScript",
      "Turborepo",
      "pnpm workspace",
      "Tiptap",
      "TanStack Query",
      "Tailwind CSS",
    ],
    evidence: [
      { href: "#decisions", label: "The decisions behind it" },
      { href: "#performance", label: "The audit" },
    ],
  },
  {
    period: "2023 — 2025",
    title: "Fullstack Developer",
    org: "Tweet World Travel Group",
    url: "https://tweetworldtravel.com",
    scope:
      "Both sides of the wire: Spring Boot microservices and the React / Next.js clients in front of them, for a travel group's agent and consumer products.",
    outcomes: [
      "Delivered five B2B/B2C products and a multilingual ERP serving roughly 1,000 users a month.",
      "Took page load from 3.2s to 1.1s and held mobile Lighthouse above 85 — the dry run for the LMS pass two years later.",
      "Mentored three junior engineers and ran the code reviews that held production quality steady.",
    ],
    tags: [
      "Java",
      "Spring Boot",
      "Microservices",
      "React",
      "Next.js",
      "TypeScript",
      "Material UI",
    ],
    evidence: [{ href: "#projects", label: "The products" }],
  },
  {
    period: "2021 — 2023",
    title: "Frontend Developer",
    org: "Minastik JSC",
    url: "https://www.minastik.com",
    subtitle: "Onsite at 3S Intersoft",
    scope:
      "React applications for operational software, working to an Agile/Scrum process with a backend team on the other side of the API.",
    outcomes: [
      "Built the UI/UX for EVN Hanoi's power-management modules — dense operational data grids on a .NET Core API.",
      "First codebase I worked in that someone else had to maintain after me, which is where the habits about naming and structure came from.",
    ],
    tags: ["React.js", "Redux Toolkit", "RESTful API", "Ant Design", "Agile"],
  },
  {
    period: "2021",
    title: "Software Engineer Intern",
    org: "FPT Software",
    url: "https://www.fpt-software.com",
    scope:
      "Built an employee-management application in C++ and learned how software gets built by more than one person.",
    outcomes: [],
    tags: ["C++"],
  },
  {
    period: "2018 — 2022",
    title: "B.Eng, Electronics & Telecommunications",
    org: "Hanoi University of Science and Technology",
    url: "https://hust.edu.vn",
    scope:
      "Engineering degree at HUST, with published research at REV-ECIT 2021.",
    outcomes: [],
    tags: [],
  },
];
---

<section id="work" class="scroll-mt-14" aria-labelledby="work-title">
  <SectionRule
    id="work"
    kicker="Record"
    title="Where I've worked"
    lead="Five years, four roles and a degree — intern, frontend developer, fullstack developer, now tech lead. Scope, outcome and stack for each; the reasoning behind the work is in the decision log rather than repeated here."
    note="2018 — present"
  />

  <ol class="border-t-2 border-rule">
    {
      ROLES.map((role) => (
        <li class="border-b-2 border-rule">
          <div class="grid gap-3 py-5 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6">
            <div>
              <p class="label text-ink-3 tabular-nums">{role.period}</p>
              {role.subtitle && (
                <p class="kicker mt-1 text-ink-3">{role.subtitle}</p>
              )}
            </div>

            <div class="min-w-0">
              <h3 class="font-mono text-lg leading-snug">
                {role.title}
                <span class="text-ink-3"> · </span>
                {role.url ? (
                  <a
                    class="link"
                    href={role.url}
                    target="_blank"
                    rel="noreferrer noopener"
                    aria-label={`${role.org} (opens in a new tab)`}
                  >
                    {role.org} ↗
                  </a>
                ) : (
                  role.org
                )}
              </h3>

              <p class="mt-2 max-w-[66ch] text-ink-2">{role.scope}</p>

              {role.outcomes.length > 0 && (
                <ul class="mt-3 border-l-4 border-ink">
                  {role.outcomes.map((outcome) => (
                    <li class="border-b-2 border-rule px-4 py-2 text-sm text-ink-2 last:border-b-0">
                      {outcome}
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                {role.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
                    {role.tags.map((tag) => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>
                )}
                {role.evidence?.map((evidence) => (
                  <a class="link text-sm" href={evidence.href}>
                    {evidence.label} →
                  </a>
                ))}
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
